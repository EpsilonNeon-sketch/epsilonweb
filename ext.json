    "site": "Epsilon Learn",
    "author": "Warren Adrian",
    "nav_btn": "Formulas",
    "html": "<!DOCTYPE html><html><head><style>body{font-family:sans-serif;padding:1rem;background:#052e16;color:#f0fdf4}textarea{width:100%;height:55vh;background:#14532d;color:#f0fdf4;border:1px solid #22c55e;border-radius:4px;padding:0.5rem;font-family:monospace}button{background:#22c55e;color:#052e16;border:none;padding:0.5rem 1rem;font-weight:bold;cursor:pointer;border-radius:4px;margin-top:0.5rem}</style></head><body><h2>Formula Sheet</h2><textarea id=\"f\" placeholder=\"Paste equations, syntax, or quick formulas here...\"></textarea><br><button onclick=\"localStorage.setItem('ep_formulas',document.getElementById('f').value)\">Save Formulas</button><script>document.getElementById('f').value=localStorage.getItem('ep_formulas')||''<\/script></body></html>"
  }
